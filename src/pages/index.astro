---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#1a120b" />
  <title>El Camino — Castle Black a Sunspear</title>
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/png" href="/icon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Kingsroad" />
</head>
<body>

<header class="topbar">
  <div id="myAvatar" class="avatar-pill" title="Tu personaje">
    <div class="avatar-medallion small"><span class="sigil">⚔</span></div>
    <div class="avatar-meta">
      <strong id="myName">Anónimo</strong>
      <small id="myHouse">Sin casa</small>
    </div>
  </div>
  <div class="titles">
    <h1>The Kingsroad</h1>
    <p class="subtitle">Castle Black → Sunspear</p>
  </div>
  <button id="settingsBtn" class="icon-btn" aria-label="Ajustes">⚙</button>
</header>

<div id="mpBanner" class="mp-banner hidden" role="status"></div>

<main>

  <section class="location-card">
    <div>
      <p class="status-label" id="statusLabel">En camino</p>
      <h2 id="currentPlace">Castle Black</h2>
      <p class="region" id="currentRegion">The Wall</p>
    </div>
    <div class="next-block">
      <span class="next-label">Próximo</span>
      <strong id="nextPlace">Last Hearth</strong>
      <span class="dist" id="nextDistance">220 leguas</span>
    </div>
  </section>

  <div class="map-wrap">
    <img class="map-bg" src="/westeros-map.jpg" alt="" loading="eager" decoding="async" />
    <svg id="map" class="map-overlay" viewBox="0 0 100 192" preserveAspectRatio="xMidYMid meet" aria-label="Mapa de Poniente"></svg>
    <div id="trackingHint" class="tracking-hint hidden">
      <button id="enableMotionBtn" class="ghost-btn">👣 Activar podómetro</button>
    </div>
    <div id="liveBadge" class="live-badge floating hidden">
      <span class="dot"></span>
      <span id="liveText">Detectando…</span>
    </div>
  </div>

  <section class="metrics">
    <div class="metric">
      <span class="metric-label">Caminado real</span>
      <span class="metric-value" id="realKm">0,00 km</span>
      <span class="metric-sub" id="realSteps">0 pasos</span>
    </div>
    <div class="metric metric-accent">
      <span class="metric-label">En Poniente</span>
      <span class="metric-value" id="westerosKm">0 leguas</span>
      <span class="metric-sub" id="progressPct">0,0% del viaje</span>
    </div>
    <div class="metric">
      <span class="metric-label">Falta</span>
      <span class="metric-value" id="remaining">— leguas</span>
      <span class="metric-sub" id="etaSub">a Sunspear</span>
    </div>
  </section>

  <section class="travelers">
    <header class="travelers-header">
      <h3>Otros viajeros</h3>
      <span id="travelersCount" class="badge">0</span>
    </header>
    <ol id="travelersList" class="travelers-list">
      <li class="empty">Nadie más en el camino todavía…</li>
    </ol>
  </section>

  <section class="journal">
    <h3>Bitácora del viaje</h3>
    <ol id="journal"></ol>
  </section>

</main>

<dialog id="onboardingDialog" class="onboarding">
  <form method="dialog" id="onboardingForm">
    <h2>El camino te espera</h2>
    <p class="onboarding-intro">Elegí tu personaje y un nombre. Otros viajeros te verán en el mapa.</p>

    <label class="field">
      <span>Tu nombre</span>
      <input type="text" id="nameInput" maxlength="20" placeholder="Como te llamen en el camino…" required />
    </label>

    <label class="field">
      <span>Código de sala</span>
      <input type="text" id="roomInput" inputmode="numeric" pattern="[0-9]*" maxlength="8" placeholder="ej: 1234" />
      <small>Solo números. Compartí el mismo código con tus amigos para verse en el mapa.</small>
    </label>

    <div class="field">
      <span class="field-label">Personaje</span>
      <div class="saga-filter" id="sagaFilter"></div>
      <div class="house-filter" id="houseFilter"></div>
      <div class="character-grid" id="characterGrid"></div>
    </div>

    <div class="dialog-actions">
      <button type="submit" class="primary-btn">Empezar el viaje</button>
    </div>
  </form>
</dialog>

<dialog id="travelerDialog" class="traveler-dialog">
  <form method="dialog">
    <div id="travelerDetail"></div>
    <div class="dialog-actions">
      <button type="submit" class="secondary-btn">Cerrar</button>
    </div>
  </form>
</dialog>

<dialog id="cityDialog" class="city-dialog">
  <form method="dialog">
    <div id="cityDetail"></div>
    <div class="dialog-actions">
      <button type="submit" class="secondary-btn">Cerrar</button>
    </div>
  </form>
</dialog>

<dialog id="settingsDialog" class="settings">
  <form method="dialog">
    <h3>Pacto con el Camino</h3>

    <label class="field">
      <span>Modo de medición detectado</span>
      <div class="detected-row">
        <output id="detectedOut">— ninguno aún —</output>
        <button type="button" id="redetectBtn" class="ghost-btn">Detectar de nuevo</button>
      </div>
    </label>

    <label class="field">
      <span>Sala actual</span>
      <output id="currentRoomOut" class="room-display">1</output>
      <small>Cambiá la sala desde "Cambiar personaje".</small>
    </label>

    <div class="dialog-actions">
      <button type="button" id="changeCharBtn" class="ghost-btn">Cambiar personaje</button>
      <button type="button" id="resetBtn" class="danger-btn">Reiniciar viaje</button>
      <button type="submit" class="primary-btn">Cerrar</button>
    </div>
  </form>
</dialog>

<script>
  import '../scripts/app.js';
</script>
</body>
</html>
