# Copiá este archivo a .env y completá con tu config de Firebase.
# Las variables PUBLIC_* se exponen al cliente vía Vite.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_DATABASE_URL=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Parámetros del viaje (no editables desde la UI)
# Con scale=2 y stride=75cm, 10000 pasos/día por 365 días = Sunspear.
PUBLIC_SCALE=2
PUBLIC_STRIDE_CM=75
PUBLIC_SENSITIVITY=1.10
